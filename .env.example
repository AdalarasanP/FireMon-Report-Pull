# FireMon API Configuration
# Copy this file to .env and fill in your actual values

# FireMon base URL (adjust domain number if needed)
FIREMON_BASE_URL=https://your-firemon-server.com/securitymanager/api/domain/1

# FireMon credentials
FIREMON_USER=your_username
FIREMON_PASS=your_password

# SSL verification (set to false if using self-signed certificates)
FIREMON_VERIFY_SSL=false
