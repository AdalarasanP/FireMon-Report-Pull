# FireMon API Configuration
# Copy this file to .env and fill in your actual values

# FireMon base URL (adjust domain number if needed)
FIREMON_BASE_URL=https://<your-firemon-server>/securitymanager/api/domain/1

# FireMon credentials
FIREMON_USER=<username>
FIREMON_PASS=<password>

# SSL verification (set to false if using self-signed certificates)
FIREMON_VERIFY_SSL=false
